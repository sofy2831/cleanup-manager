rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return signedIn() ? request.auth.uid : "";
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*');
    }

    function sizeUnder(maxMb) {
      return request.resource != null
        && request.resource.size < maxMb * 1024 * 1024;
    }

    // ======================================================
    // LOGOS CONCIERGERIE
    // ex: conciergerie-logos/{uid}/logo.png
    // ======================================================
    match /conciergerie-logos/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && myUid() == uid
        && isImage()
        && sizeUnder(2);
      allow delete: if signedIn() && myUid() == uid;
    }

    // ======================================================
    // PREUVES PHOTOS
    // ex: proofPhotos/{prestationId}/PHOTOS/{token}/...
    // ======================================================
    match /proofPhotos/{prestationId}/{missionId}/{token}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && isImage()
        && sizeUnder(15);
      allow delete: if signedIn();
    }

    // ======================================================
    // PHOTOS MESSAGERIE (si utilisées)
    // adapte le chemin exact si besoin
    // ======================================================
    match /thread-photos/{threadId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && isImage()
        && sizeUnder(15);
      allow delete: if signedIn();
    }

    // ======================================================
    // DEFAULT DENY
    // ======================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
