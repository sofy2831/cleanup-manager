rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================= AUTH =================
    function signedIn() { return request.auth != null; }
    function myUid() { return signedIn() ? request.auth.uid : ""; }
    function myEmailLower() {
      return signedIn() && (request.auth.token.email is string)
        ? request.auth.token.email.lower()
        : "";
    }

    // ================= DEV =================
    function isDevEmail() {
      return signedIn() && myEmailLower() == "s.dumas974@gmail.com";
    }

    function isStaffTesterEmail() {
      return signedIn() && myEmailLower() == "mathildeconciergerie45@gmail.com";
    }

    function devBypass() { return isDevEmail(); }
    function staffBypass() { return isStaffTesterEmail(); }

    // ================= USER HELPERS =================
    function myUserDoc() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function myOwnerDocId() {
      let u = myUserDoc();
      return (u != null && (u.ownerDocId is string)) ? u.ownerDocId : "";
    }

    function myConciergerieUid() {
      let u = myUserDoc();
      return (u != null && (u.conciergerieUid is string)) ? u.conciergerieUid : "";
    }

    function isOwnerByDocId(data) {
      return signedIn()
        && (myOwnerDocId() != "")
        && (myConciergerieUid() != "")
        && (data.ownerDocId == myOwnerDocId())
        && (data.conciergerieUid == myConciergerieUid());
    }

    // ================= DAY TOKENS =================
    function tokenDoc(tokenId) {
      return get(/databases/$(database)/documents/dayTokens/$(tokenId)).data;
    }

    function tokenIsActiveById(tokenId) {
      let t = tokenDoc(tokenId);
      return (t.active == true)
        && (
          (t.expiresAt is timestamp && request.time < t.expiresAt)
          || (t.expiresAtMs is int && request.time.toMillis() < t.expiresAtMs)
        );
    }

    function tokenMatchesEvent(tokenId, eventId) {
      let t = tokenDoc(tokenId);
      return (
        t.prestationId == eventId
        || t.eventId == eventId
      );
    }

    function tokenAllowsMission(tokenId, missionId) {
      let t = tokenDoc(tokenId);
      return t.missionTypes is list && t.missionTypes.hasAny([missionId]);
    }

    // ================= USERS =================
    match /users/{uid} {

      allow create: if request.auth.uid == uid;
      allow read: if request.auth.uid == uid;

      allow update: if request.auth.uid == uid
        || devBypass();

      allow delete: if false;
    }

    // ================= OWNERS =================
    match /owners/{ownerDocId} {

      allow read: if signedIn() && (
        resource.data.conciergerieUid == myUid()
        || resource.data.ownerUid == myUid()
      );

      allow create: if signedIn()
        && request.resource.data.conciergerieUid == myUid();

      allow update: if signedIn()
        && (
          resource.data.conciergerieUid == myUid()
          || resource.data.ownerUid == myUid()
        );

      allow delete: if false;
    }

    // ================= HOMES =================
    match /homes/{homeId} {

      allow read: if signedIn() && (
        resource.data.conciergerieUid == myUid()
        || resource.data.ownerUid == myUid()
        || isOwnerByDocId(resource.data)
      );

      allow create: if signedIn()
        && request.resource.data.conciergerieUid == myUid();

      allow update: if signedIn()
        && resource.data.conciergerieUid == myUid();

      allow delete: if signedIn()
        && resource.data.conciergerieUid == myUid();
    }

    // ================= EVENTS =================
    match /events/{eventId} {

      allow read: if signedIn() && (
        resource.data.conciergerieUid == myUid()
        || resource.data.ownerUid == myUid()
      );

      allow create, update, delete: if signedIn()
        && resource.data.conciergerieUid == myUid();
    }

    // ================= SALESDOCUMENTS =================
    match /salesDocuments/{docId} {

      function isConciergerieDoc(data) {
        return data.conciergerieUid == myUid();
      }

      function isOwnerDoc(data) {
        return data.ownerUid == myUid() && data.ownerVisible == true;
      }

      allow read: if isConciergerieDoc(resource.data)
        || isOwnerDoc(resource.data);

      allow create: if signedIn()
        && request.resource.data.conciergerieUid == myUid();

      // 🔒 FIX CRITIQUE
      allow update: if signedIn()
        && resource.data.conciergerieUid == myUid()
        && request.resource.data.conciergerieUid == resource.data.conciergerieUid
        && (
          !("ownerUid" in request.resource.data)
          || request.resource.data.ownerUid == resource.data.ownerUid
        );

      allow delete: if signedIn()
        && resource.data.conciergerieUid == myUid();
    }

    // ================= REQUESTS (AJOUT) =================
    match /requests/{requestId} {

      function isConciergerieRequest(data) {
        return data.conciergerieUid == myUid();
      }

      function isOwnerRequest(data) {
        return data.ownerUid == myUid();
      }

      allow read: if signedIn() && (
        isConciergerieRequest(resource.data)
        || isOwnerRequest(resource.data)
      );

      allow create: if signedIn()
        && request.resource.data.conciergerieUid == myUid()
        && request.resource.data.ownerUid != ""
        && request.resource.data.docType in ["invoice","credit"];

      allow update: if signedIn()
        && resource.data.conciergerieUid == myUid();

      allow delete: if false;
    }

    // ================= DAY TOKENS =================
    match /dayTokens/{tokenId} {

      allow create: if signedIn()
        && request.resource.data.conciergerieUid == myUid();

      allow read: if signedIn()
        && resource.data.conciergerieUid == myUid();

      allow get: if true;

      allow update: if signedIn()
        && resource.data.conciergerieUid == myUid();

      allow delete: if false;
    }

    // ================= DEFAULT =================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
